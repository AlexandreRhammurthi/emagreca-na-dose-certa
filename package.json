{
  "name": "emagreca-na-dose-certa",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy --assets ./public/",
    "test": "npm run test:local",
    "test:local": "node scripts/run-test-suite.mjs",
    "test:civil-date": "node --import ./tests/local/no-network.mjs --test tests/local/unit/civil-date.test.mjs",
    "test:integration:rls": "node tests/integration/supabase/rls.integration.mjs",
    "test:integration:onboarding": "node tests/integration/supabase/onboarding-rls.integration.mjs",
    "test:rls": "npm run test:integration:rls"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.100.0"
  },
  "devDependencies": {
    "supabase": "^2.113.0"
  }
}
